---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../site';
import { graph, person, website } from '../lib/schema';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  article?: { published: Date; modified?: Date; tags?: string[] };
  schema?: object[];
}
const { title, description = SITE.description, type = 'website', image = '/og.jpg', article, schema = [] } = Astro.props;
const ogImage = new URL(image, Astro.site);
const jsonLd = graph(person, website, ...schema);
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/blog/', label: 'Notes' },
  { href: '/about/', label: 'About' },
  { href: '/build/', label: 'Ghostline' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07080a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.name} />
    <meta property="og:locale" content="en_US" />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
    {article && <meta property="article:author" content="https://cansevengin.com/about/" />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="Can Sevengin" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="me" href={SITE.linkedin} />
    <link rel="me" href="https://github.com/CanSevengin" />
    <link rel="author" href="/about/" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="preload" href="/can-sevengin.webp" as="image" type="image/webp" fetchpriority="low" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav-in">
        <a href="/" class="brand" aria-label="Can Sevengin, home" translate="no">
          <Logo size={32} class="logo" />
          <span class="word">Can<span>Sevengin</span></span>
        </a>
        <nav aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={`mailto:${SITE.email}`}>Say Hi</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="container foot-in">
        <p class="foot-name"><Logo size={26} />Can Sevengin</p>
        <div class="foot-links">
          <a href={`mailto:${SITE.email}`}><Icon name="envelope-simple" size={16} />{SITE.email}</a>
          {SITE.linkedin && <a href={SITE.linkedin} rel="me noopener" target="_blank"><Icon name="linkedin-logo" size={16} />LinkedIn</a>}
          <a href="/build/"><Icon name="lightning" size={16} />Ghostline</a>
          <a href="/how-it-works/"><Icon name="gear-six" size={16} />Built with Claude</a>
          <a href="/rss.xml"><Icon name="rss" size={16} />RSS</a>
        </div>
        <p class="foot-c">© {new Date().getFullYear()} Can Sevengin. Written in Istanbul. Stock photos from <a href="https://unsplash.com/?utm_source=cansevengin&utm_medium=referral" rel="noopener" target="_blank">Unsplash</a>.</p>
      </div>
    </footer>

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      els.forEach((el) => io.observe(el));

      // Nav turns light while it sits over a light section (Apple-style)
      const nav = document.querySelector<HTMLElement>('.nav');
      const lights = [...document.querySelectorAll<HTMLElement>('.t-light, .t-gray')];
      let ticking = false;
      const check = () => {
        ticking = false;
        const on = lights.some((el) => { const r = el.getBoundingClientRect(); return r.top <= 28 && r.bottom >= 28; });
        nav?.classList.toggle('on-light', on);
      };
      if (nav && lights.length) {
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(check); } }, { passive: true });
        check();
      }
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgb(7 8 10 / 0.6);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--line);
  }
  .nav { transition: background-color .35s var(--ease), border-color .35s var(--ease); }
  .nav.on-light {
    --ink: #1d1d1f; --ink-2: #424245; --ink-3: #86868b; --bg-2: rgb(0 0 0 / .06); --line: rgb(0 0 0 / .08);
    background: rgb(255 255 255 / .72); color: var(--ink);
  }
  .nav-in { height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .brand :global(.logo) { transition: transform .5s var(--ease); }
  .brand:hover :global(.logo) { transform: rotate(-90deg); }
  .word { font-size: 16px; letter-spacing: -0.02em; }
  .word span { color: var(--ink-3); margin-left: 5px; font-weight: 500; transition: color .2s; }
  .brand:hover .word span { color: var(--ink); }
  nav { display: flex; align-items: center; gap: 6px; }
  nav a:not(.btn) {
    text-decoration: none; color: var(--ink-2); font-size: 14px;
    padding: 8px 14px; border-radius: var(--r-pill);
    transition: color .2s, background-color .2s;
  }
  nav a:not(.btn):hover { color: var(--ink); background: var(--bg-2); }
  nav a[aria-current] { color: var(--ink); }
  .nav-cta { --h: 34px; margin-left: 8px; padding: 0 16px; font-size: 14px; }
  @media (max-width: 560px) {
    .word { display: none; }
    nav a[href='/build/'] { display: none; }
    nav a:not(.btn) { padding: 8px 10px; }
  }

  .foot { border-top: 1px solid var(--line); margin-top: 0; padding: 40px 0 48px; }
  .foot-in { display: grid; grid-template-columns: 1fr auto; gap: 18px 32px; align-items: center; }
  .foot-name { margin: 0; font-weight: 600; letter-spacing: -0.01em; display: inline-flex; align-items: center; gap: 10px; }
  .foot-links { display: flex; gap: 22px; flex-wrap: wrap; justify-self: end; }
  .foot-links a { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); text-decoration: none; font-size: 14px; }
  .foot-links a:hover { color: var(--accent); }
  .foot-c { grid-column: 1 / -1; margin: 0; color: var(--ink-3); font-size: 13px; }
  .foot-c a { color: var(--ink-2); }
  @media (max-width: 720px) { .foot-in { grid-template-columns: 1fr; } .foot-links { justify-self: start; } }
</style>
