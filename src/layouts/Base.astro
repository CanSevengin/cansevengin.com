---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/blog/', label: 'Writing' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07080a" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="container nav-in">
        <a href="/" class="brand" aria-label="Can Sevengin, home" translate="no">
          <span class="glyph" aria-hidden="true">cs</span>
          <span>Can Sevengin</span>
        </a>
        <nav aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={`mailto:${SITE.email}`} class="btn btn-primary nav-cta">Email Me</a>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="container foot-in">
        <p class="foot-name">Can Sevengin</p>
        <div class="foot-links">
          <a href={`mailto:${SITE.email}`}><Icon name="envelope-simple" size={16} />{SITE.email}</a>
          {SITE.linkedin && <a href={SITE.linkedin} rel="me noopener" target="_blank"><Icon name="linkedin-logo" size={16} />LinkedIn</a>}
          <a href="/rss.xml"><Icon name="rss" size={16} />RSS</a>
        </div>
        <p class="foot-c">© {new Date().getFullYear()} Can Sevengin. Written in Istanbul.</p>
      </div>
    </footer>

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgb(7 8 10 / 0.72);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom: 1px solid var(--line);
  }
  .nav-in { height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-weight: 600; letter-spacing: -0.01em; white-space: nowrap; }
  .glyph {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 9px;
    background: var(--accent); color: var(--accent-ink);
    font: 700 13px/1 var(--mono); letter-spacing: -0.04em;
  }
  nav { display: flex; align-items: center; gap: 6px; }
  nav a:not(.btn) {
    text-decoration: none; color: var(--ink-2); font-size: 15px;
    padding: 8px 14px; border-radius: var(--r-pill);
    transition: color .2s, background-color .2s;
  }
  nav a:not(.btn):hover { color: var(--ink); background: var(--bg-2); }
  nav a[aria-current] { color: var(--ink); }
  .nav-cta { --h: 38px; margin-left: 8px; padding: 0 16px; font-size: 14px; }
  @media (max-width: 560px) {
    .brand span:last-child { display: none; }
    nav a:not(.btn) { padding: 8px 10px; }
  }

  .foot { border-top: 1px solid var(--line); margin-top: 0; padding: 40px 0 48px; }
  .foot-in { display: grid; grid-template-columns: 1fr auto; gap: 18px 32px; align-items: center; }
  .foot-name { margin: 0; font-weight: 600; letter-spacing: -0.01em; }
  .foot-links { display: flex; gap: 22px; flex-wrap: wrap; justify-self: end; }
  .foot-links a { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-2); text-decoration: none; font-size: 14px; }
  .foot-links a:hover { color: var(--accent); }
  .foot-c { grid-column: 1 / -1; margin: 0; color: var(--ink-3); font-size: 13px; }
  @media (max-width: 720px) { .foot-in { grid-template-columns: 1fr; } .foot-links { justify-self: start; } }
</style>
