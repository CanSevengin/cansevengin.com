---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Not found">
  <section class="container nf">
    <p class="code mono">404</p>
    <h1>This route doesn’t exist.</h1>
    <a class="btn btn-primary" href="/">Back to Home <Icon name="arrow-right" /></a>
  </section>
</Base>

<style>
  .nf { min-height: 70dvh; display: grid; place-content: center; justify-items: start; gap: 22px; padding-top: 40px; padding-bottom: 80px; }
  .code { margin: 0; font-size: clamp(5rem, 16vw, 11rem); line-height: 0.9; color: var(--accent); letter-spacing: -0.04em; }
  h1 { margin: 0; font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -0.035em; font-weight: 650; }
</style>
