---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../site';

const posts = (await getPosts()).slice(0, 5);
const themes = [
  {
    n: '01',
    t: 'AI that does real work',
    d: 'Agents, assistants and workflows judged by one test: does it save a team hours this week, or just look good in a demo?',
  },
  {
    n: '02',
    t: 'Automation for small teams',
    d: 'n8n, APIs and plain spreadsheets. How a five-person company gets the operational leverage of a fifty-person one.',
  },
  {
    n: '03',
    t: 'Selling across borders',
    d: 'Export, distributors, marketplaces and Amazon. What changes when the buyer is in another country and another language.',
  },
];
---
<Base>
  <section class="hero wrap">
    <p class="eyebrow">Istanbul · International sales · AI & automation</p>
    <h1 class="serif">
      I help brands sell <em>across borders</em>, and build the AI systems that keep the machine running.
    </h1>
    <p class="lede measure">
      I'm Can. I work in export and international sales, and I've spent the last decade on the other side
      too: running e-commerce, performance marketing and an automation agency for small businesses.
      This is where I write down what actually works.
    </p>
    <div class="actions">
      <a href="/blog/" class="btn primary">Read the writing</a>
      <a href="/about/" class="btn">More about me</a>
    </div>
  </section>

  <section class="wrap"><div class="themes">
    {themes.map((x) => (
      <div class="theme">
        <span class="n">{x.n}</span>
        <h2>{x.t}</h2>
        <p>{x.d}</p>
      </div>
    ))}
  </div></section>

  <section class="wrap latest">
    <div class="head">
      <h2 class="serif">Latest writing</h2>
      <a href="/blog/">All posts →</a>
    </div>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .hero { padding: 96px 20px 72px; }
  h1 {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 22px 0 28px;
    max-width: 17ch;
  }
  h1 em { color: var(--accent); }
  .lede { font-size: 19px; color: var(--ink-2); margin: 0; }
  .actions { display: flex; gap: 12px; margin-top: 34px; flex-wrap: wrap; }
  .btn { padding: 11px 20px; border-radius: 999px; border: 1px solid var(--rule); text-decoration: none; font-size: 15px; font-weight: 500; }
  .btn:hover { border-color: var(--ink); }
  .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .btn.primary:hover { background: var(--accent); border-color: var(--accent); }

  .themes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 0; }
  .theme { padding: 32px 28px 36px 0; }
  .theme + .theme { padding-left: 28px; border-left: 1px solid var(--rule); }
  .n { font: 13px var(--mono); color: var(--accent); }
  .theme h2 { font: 400 1.7rem/1.15 var(--serif); margin: 14px 0 10px; }
  .theme p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  @media (max-width: 820px) {
    .themes { grid-template-columns: 1fr; }
    .theme, .theme + .theme { padding: 28px 0; border-left: 0; }
    .theme + .theme { border-top: 1px solid var(--rule); }
  }

  .latest { margin-top: 96px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; }
  .head h2 { font-size: 2.4rem; margin: 0; }
  .head a { font-size: 15px; color: var(--ink-2); }
</style>
