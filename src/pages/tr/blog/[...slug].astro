---
import Post from '../../../views/Post.astro';
import { getPosts, slugOf } from '../../../site';

export async function getStaticPaths() {
  const posts = await getPosts('tr');
  const others = new Set((await getPosts('en')).map(slugOf));
  return posts.map((post, i) => ({
    params: { slug: slugOf(post) },
    props: { post, next: posts[i + 1] ?? posts[0] ?? null, hasAlt: others.has(slugOf(post)) },
  }));
}
const { post, next, hasAlt } = Astro.props;
---
<Post lang="tr" post={post} next={next} hasAlt={hasAlt} />
