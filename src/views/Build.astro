---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getPosts, SITE, lp, type Lang } from '../site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const posts = await getPosts('en');
const PRODUCT = 'Ghostline';
const REPO = 'https://github.com/CanSevengin/ghostline';

const T = {
  en: {
    title: `${PRODUCT}: A Self-running Publishing Agent Built on Claude`,
    desc: `${PRODUCT} is a personal publishing agent built on Claude. It learns your background and voice, then researches, writes, checks and publishes notes on your site while you work.`,
    kicker: 'What I’m building', tag: 'Your expertise, published while you work.',
    lede: 'A personal publishing agent built on Claude. It learns who you are and how you sound, then keeps your site alive: research, writing, fact checks, publishing and SEO, twice a week, in more than one language.',
    early: 'Get Early Access', gh: 'View on GitHub',
    mailSubject: `${PRODUCT} early access`, mailBody: `Hi Can, I would like to try ${PRODUCT}.\n\nWhat I do:\nWhere I would publish:\n`,
    problemH: 'The problem.',
    problem: 'People with the most useful knowledge, the export manager, the operator, the founder, are the ones with no time to write. Their expertise stays in their heads and their inboxes, and their online presence stays a stale LinkedIn profile.',
    caseH: 'Case study #1: this site.', caseS: `cansevengin.com is the first site run by ${PRODUCT}. Everything on it, including this page, was built with Claude.`,
    facts: [
      { n: '1', l: 'morning to build the site, the agent and the SEO setup, with Claude' },
      { n: String(posts.length), l: 'notes published so far, each in English and Turkish' },
      { n: '2', l: 'new notes a week, researched and published on their own' },
      { n: '0', l: 'hours a week I spend writing them' },
    ],
    more: 'See exactly how it works',
    stepsH: 'What it does, every run.',
    steps: [
      ['magnifying-glass', 'Research', 'What changed in your field in the last 1-2 weeks, and what people are actually searching for.'],
      ['pen-nib', 'Write', 'A 600-900 word note in your voice, grounded in your real background, in every language you publish in. No invented stories.'],
      ['check-circle', 'Check', 'Facts verified against sources, pitches removed, style rules enforced, site build tested.'],
      ['rocket-launch', 'Publish', 'Committed to your site, deployed, announced to search engines.'],
      ['chat-circle-text', 'Report', 'A short summary and the link. Reply to change or remove it.'],
    ],
    forH: 'Who it’s for.',
    forL: ['Export, sales and e-commerce professionals with real field knowledge', 'Operators and founders who want a presence but not another job', 'Anyone whose expertise is valuable and whose calendar is full'],
    neverH: 'What it never does.',
    neverL: ['Invent facts, numbers, quotes, clients or stories', 'Share your employer’s confidential information', 'Hide that it’s AI: every note is disclosed as drafted with Claude', 'Publish anything you can’t edit or remove with one reply'],
    roadH: 'Where it’s going.',
    road: [
      { tag: 'Now', now: true, h: 'v0: live on this site', p: 'Runs as a scheduled Claude agent, twice a week, since 8 October 2026. Now publishing in English and Turkish, across five topics.' },
      { tag: 'Built', h: 'v0.1: Claude API CLI', p: 'Open source on GitHub: research with Claude’s web search tool, structured writing, validation, publishing and IndexNow.' },
      { tag: 'Next', h: 'v1: anyone can onboard', p: 'A hosted version on the Claude API: an onboarding interview that builds your profile from your CV and LinkedIn, voice calibration from your own writing, and approve-or-auto publishing.' },
      { tag: 'Later', h: 'v2: beyond the blog', p: 'LinkedIn drafts from each note, more languages for cross-border professionals, and a simple results dashboard.' },
    ],
    closeH: 'Want one for yourself?', closeP: 'I’m looking for a handful of early users to shape v1. No cost, just honest feedback.',
  },
  tr: {
    title: `${PRODUCT}: Claude Üzerine Kurulu, Kendi Kendine Çalışan Yayın Ajanı`,
    desc: `${PRODUCT}, Claude üzerine kurulu kişisel bir yayın ajanı. Geçmişini ve üslubunu öğrenir, sen çalışırken sitende notları araştırır, yazar, kontrol eder ve yayınlar.`,
    kicker: 'Ne geliştiriyorum', tag: 'Sen çalışırken uzmanlığın yayında.',
    lede: 'Claude üzerine kurulu kişisel bir yayın ajanı. Kim olduğunu ve nasıl konuştuğunu öğrenir, sonra siteni canlı tutar: araştırma, yazım, doğrulama, yayın ve SEO, haftada iki kez, birden fazla dilde.',
    early: 'Erken Erişim İste', gh: 'GitHub’da İncele',
    mailSubject: `${PRODUCT} erken erişim`, mailBody: `Merhaba Can, ${PRODUCT}’ı denemek istiyorum.\n\nNe iş yapıyorum:\nNerede yayınlayacağım:\n`,
    problemH: 'Sorun.',
    problem: 'En işe yarar bilgiye sahip insanlar, yani ihracat müdürü, operasyoncu, kurucu, yazmaya hiç vakti olmayanlar. Uzmanlıkları kafalarında ve gelen kutularında kalıyor, internetteki varlıkları da güncellenmeyen bir LinkedIn profilinden ibaret.',
    caseH: 'Vaka #1: bu site.', caseS: `cansevengin.com, ${PRODUCT} ile yönetilen ilk site. Bu sayfa dahil üzerindeki her şey Claude ile yapıldı.`,
    facts: [
      { n: '1', l: 'sabah: site, ajan ve SEO kurulumu Claude ile bu sürede yapıldı' },
      { n: String(posts.length), l: 'not yayınlandı, her biri İngilizce ve Türkçe' },
      { n: '2', l: 'yeni not her hafta, kendi kendine araştırılıp yayınlanıyor' },
      { n: '0', l: 'saat: haftada bunları yazmaya harcadığım süre' },
    ],
    more: 'Tam olarak nasıl çalıştığına bak',
    stepsH: 'Her çalıştığında ne yapıyor.',
    steps: [
      ['magnifying-glass', 'Araştırır', 'Son 1-2 haftada alanında neyin değiştiğini ve insanların gerçekten neyi aradığını bulur.'],
      ['pen-nib', 'Yazar', 'Senin üslubunla, gerçek geçmişine dayanan 600-900 kelimelik bir not, yayın yaptığın her dilde. Uydurma hikaye yok.'],
      ['check-circle', 'Kontrol eder', 'Bilgiler kaynaklarla doğrulanır, satış dili temizlenir, yazım kuralları uygulanır, site derlemesi test edilir.'],
      ['rocket-launch', 'Yayınlar', 'Sitene eklenir, yayına alınır, arama motorlarına bildirilir.'],
      ['chat-circle-text', 'Rapor verir', 'Kısa bir özet ve link gönderir. Değiştirmek ya da kaldırmak için yanıt vermen yeterli.'],
    ],
    forH: 'Kimler için.',
    forL: ['Sahadan gerçek bilgisi olan ihracat, satış ve e-ticaret profesyonelleri', 'Görünür olmak isteyen ama ikinci bir iş istemeyen operasyoncular ve kurucular', 'Uzmanlığı değerli, takvimi dolu olan herkes'],
    neverH: 'Asla yapmadıkları.',
    neverL: ['Bilgi, rakam, alıntı, müşteri ya da hikaye uydurmak', 'İşvereninin gizli bilgilerini paylaşmak', 'Yapay zeka olduğunu saklamak: her not Claude ile yazıldığını belirtir', 'Tek bir yanıtla düzenleyemeyeceğin ya da kaldıramayacağın bir şey yayınlamak'],
    roadH: 'Nereye gidiyor.',
    road: [
      { tag: 'Şimdi', now: true, h: 'v0: bu sitede canlı', p: '8 Ekim 2026’dan beri haftada iki kez zamanlanmış bir Claude ajanı olarak çalışıyor. Artık beş konuda, İngilizce ve Türkçe yayın yapıyor.' },
      { tag: 'Hazır', h: 'v0.1: Claude API CLI', p: 'GitHub’da açık kaynak: Claude’un web arama aracıyla araştırma, yapılandırılmış yazım, doğrulama, yayın ve IndexNow.' },
      { tag: 'Sırada', h: 'v1: herkes katılabilir', p: 'Claude API üzerinde barındırılan bir sürüm: CV’nden ve LinkedIn’inden profilini çıkaran bir tanışma görüşmesi, kendi yazılarından üslup ayarı, onaylı ya da otomatik yayın.' },
      { tag: 'Sonra', h: 'v2: blogun ötesi', p: 'Her nottan LinkedIn taslakları, sınır ötesi çalışanlar için daha fazla dil ve basit bir sonuç paneli.' },
    ],
    closeH: 'Senin için de bir tane?', closeP: 'v1’i şekillendirecek birkaç erken kullanıcı arıyorum. Ücret yok, sadece dürüst geri bildirim.',
  },
}[lang];
---
<Base
  lang={lang}
  title={T.title}
  description={T.desc}
  schema={[{
    '@type': 'SoftwareApplication',
    name: PRODUCT,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: 'A self-running personal publishing agent built on Claude.',
    url: 'https://cansevengin.com/build/',
    codeRepository: REPO,
    author: { '@id': 'https://cansevengin.com/#person' },
  }]}
>
  <section class="container hero">
    <p class="kicker" data-reveal>{T.kicker}</p>
    <h1 data-reveal style="--i:1">{PRODUCT}.<br /><span class="grad">{T.tag}</span></h1>
    <p class="lede" data-reveal style="--i:2">{T.lede}</p>
    <div class="ctas" data-reveal style="--i:3">
      <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=${encodeURIComponent(T.mailSubject)}&body=${encodeURIComponent(T.mailBody)}`}>{T.early} <Icon name="arrow-right" /></a>
      <a class="btn" href={REPO} target="_blank" rel="noopener"><Icon name="github-logo" size={18} />{T.gh}</a>
    </div>
  </section>

  <section class="t-light lsec">
    <div class="container">
      <h2 data-reveal>{T.problemH}</h2>
      <p class="big" data-reveal>{T.problem}</p>
    </div>
  </section>

  <section class="container block">
    <h2 data-reveal>{T.caseH}</h2>
    <p class="sub" data-reveal>{T.caseS}</p>
    <div class="facts">
      {T.facts.map((f, i) => (
        <div class="fact" data-reveal style={`--i:${i}`}>
          <p class="fn">{f.n}</p>
          <p class="fl">{f.l}</p>
        </div>
      ))}
    </div>
    <a class="more" href={lp(lang, '/how-it-works/')} data-reveal>{T.more} <Icon name="arrow-right" size={16} /></a>
  </section>

  <section class="t-gray lsec">
   <div class="container">
    <h2 data-reveal>{T.stepsH}</h2>
    <ol class="steps">
      {T.steps.map(([icon, h, d], i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <Icon name={icon} size={24} class="s-ic" />
          <div>
            <h3>{h}</h3>
            <p>{d}</p>
          </div>
        </li>
      ))}
    </ol>
   </div>
  </section>

  <section class="container block two">
    <div data-reveal>
      <h2>{T.forH}</h2>
      <ul class="list">{T.forL.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div data-reveal style="--i:1">
      <h2>{T.neverH}</h2>
      <ul class="list">{T.neverL.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section class="t-light lsec">
   <div class="container">
    <h2 data-reveal>{T.roadH}</h2>
    <ol class="road">
      {T.road.map((r, i) => (
        <li data-reveal style={`--i:${i % 3}`}><span class:list={['tag', { now: 'now' in r }]}>{r.tag}</span><div><h3>{r.h}</h3><p>{r.p}</p></div></li>
      ))}
    </ol>
   </div>
  </section>

  <section class="container close">
    <h2 data-reveal>{T.closeH}</h2>
    <p data-reveal style="--i:1">{T.closeP}</p>
    <div class="ctas center" data-reveal style="--i:2">
      <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=${encodeURIComponent(T.mailSubject)}`}>{T.early} <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 88px; }
  .kicker { margin: 0 0 18px; color: var(--accent); font-weight: 600; font-size: 16px; letter-spacing: -0.01em; }
  h1 { margin: 0; font-size: clamp(2.8rem, 7vw, 5.6rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1.02; max-width: 15ch; }
  .grad { background: linear-gradient(92deg, #c8f031 10%, #e9ff9e 50%, #8ee0b5 95%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .06em; display: inline-block; }
  .lede { margin: 28px 0 0; max-width: 40rem; font-size: clamp(19px, 2vw, 23px); line-height: 1.38; color: var(--ink-2); letter-spacing: -0.015em; }
  .ctas { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
  .ctas.center { justify-content: center; }

  .block { padding-top: 16vh; padding-bottom: 16vh; }
  .lsec { padding: 16vh 0; }
  .lsec h2 { margin: 0; font-size: clamp(2rem, 4.6vw, 3.6rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1.04; }
  .t-light .big { color: var(--ink); }
  .t-gray .steps li { background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / .04), 0 10px 30px -16px rgb(0 0 0 / .16); }
  .t-light .tag { background: var(--bg-1); }
  .t-light .tag.now { background: #c8f031; color: #0b0d05; }
  .block h2, .close h2 { margin: 0; font-size: clamp(2rem, 4.6vw, 3.6rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1.04; }
  .big { margin: 24px 0 0; max-width: 30ch; font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1.22; letter-spacing: -0.03em; font-weight: 600; color: var(--ink-2); }
  .sub { margin: 16px 0 0; color: var(--ink-2); font-size: 19px; max-width: 42rem; }

  .facts { margin-top: 40px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .fact { padding: 26px 24px 28px; border-radius: 24px; background: var(--bg-1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06); }
  .fn { margin: 0; font-size: clamp(3rem, 6vw, 4.6rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1; background: linear-gradient(180deg, #fff 20%, #6c727b); -webkit-background-clip: text; background-clip: text; color: transparent; font-variant-numeric: tabular-nums; }
  .fl { margin: 12px 0 0; color: var(--ink-2); font-size: 15.5px; line-height: 1.4; }
  @media (max-width: 860px) { .facts { grid-template-columns: 1fr 1fr; } }
  .more { display: inline-flex; align-items: center; gap: 8px; margin-top: 24px; color: var(--accent); text-decoration: none; font-weight: 500; }
  .more:hover { text-decoration: underline; text-underline-offset: 4px; }

  .steps { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 12px; }
  .steps li { display: flex; gap: 18px; align-items: flex-start; padding: 22px 24px; border-radius: 20px; background: var(--bg-1); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .06); }
  .steps :global(.s-ic) { color: var(--accent); flex: none; margin-top: 2px; }
  .steps h3 { margin: 0; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; }
  .steps p { margin: 4px 0 0; color: var(--ink-2); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
  .list { margin: 28px 0 0; padding-left: 1.2em; display: grid; gap: 12px; font-size: 18px; line-height: 1.45; }
  .list li::marker { color: var(--accent); }

  .road { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 0; }
  .road li { display: grid; grid-template-columns: 100px 1fr; gap: 24px; padding: 24px 0; border-top: 1px solid var(--line); }
  .tag { align-self: start; justify-self: start; font-size: 13px; font-weight: 600; padding: 5px 12px; border-radius: 999px; background: rgb(255 255 255 / .07); color: var(--ink-2); }
  .tag.now { background: var(--accent); color: var(--accent-ink); }
  .road h3 { margin: 0; font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; }
  .road p { margin: 6px 0 0; color: var(--ink-2); max-width: 46rem; }
  @media (max-width: 560px) { .road li { grid-template-columns: 1fr; gap: 10px; } }

  .close { padding-top: 18vh; padding-bottom: 18vh; text-align: center; }
  .close h2 { margin: 0 auto; max-width: 16ch; }
  .close p { margin: 18px auto 0; max-width: 32rem; color: var(--ink-2); font-size: 19px; }
</style>
