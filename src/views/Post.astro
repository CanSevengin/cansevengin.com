---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Icon from '../components/Icon.astro';
import { blogPosting, breadcrumbs } from '../lib/schema';
import { CATEGORIES } from '../lib/categories';
import { formatDate, readingTime, SITE, UI, lp, slugOf, postUrl, type Lang, type Post } from '../site';

interface Props { post: Post; next: Post | null; lang: Lang; hasAlt: boolean }
const { post, next, lang, hasAlt } = Astro.props;
const u = UI[lang];
const { Content, headings } = await render(post);
const { title, description, date, tags, draft, category } = post.data;
const slug = slugOf(post);
const toc = headings.filter((h) => h.depth === 2);
const nextPost = next && next.id !== post.id ? next : null;
const cat = CATEGORIES[category];
const T = {
  en: { back: 'All Notes', toc: 'On this page', ai: 'Researched and drafted with Claude, in my voice.', how: 'How this site works', ask: 'Thoughts or pushback? I’d like to hear them.', write: 'Write to Me', copy: 'Copy Link', copied: 'Link Copied', fail: 'Copy failed', next: 'Read next', home: 'Home', notes: 'Notes', re: 'Re: ' },
  tr: { back: 'Tüm Notlar', toc: 'Bu sayfada', ai: 'Claude ile araştırılıp benim üslubumla yazıldı.', how: 'Bu site nasıl çalışıyor', ask: 'Bir fikrin ya da itirazın mı var? Duymak isterim.', write: 'Bana Yaz', copy: 'Linki Kopyala', copied: 'Link Kopyalandı', fail: 'Kopyalanamadı', next: 'Sıradaki not', home: 'Ana sayfa', notes: 'Notlar', re: 'Ynt: ' },
}[lang];
const base = 'https://cansevengin.com';
const ogImage = lang === 'tr' ? `/og/tr/${slug}.png` : `/og/${slug}.png`;
---
<Base
  lang={lang}
  alt={hasAlt ? undefined : false}
  title={title}
  description={description}
  type="article"
  image={ogImage}
  article={{ published: date, tags }}
  schema={[
    blogPosting({ slug, title, description, date, tags, words: (post.body ?? '').split(/\s+/).length, lang, section: cat[lang].name }),
    breadcrumbs([
      { name: T.home, url: base + lp(lang, '/') },
      { name: T.notes, url: base + lp(lang, '/blog/') },
      { name: cat[lang].name, url: base + lp(lang, `/blog/topic/${cat[lang].slug}/`) },
      { name: title, url: base + postUrl(post) },
    ]),
  ]}
>
  <div class="progress" aria-hidden="true"></div>

  <article class="t-light art">
    <header class="container ph">
      <a href={lp(lang, '/blog/')} class="back"><Icon name="arrow-left" size={16} />{T.back}</a>
      <p class="meta" data-reveal>
        <a class="cat" href={lp(lang, `/blog/topic/${cat[lang].slug}/`)}><Icon name={cat.icon} size={15} />{cat[lang].name}</a>
        <span>{formatDate(date, lang)}</span>
        <span>{readingTime(post.body)} {u.minRead}</span>
        {draft && <span class="draft">{u.draft}</span>}
      </p>
      <h1 data-reveal style="--i:1">{title}</h1>
      <p class="dek" data-reveal style="--i:2">{description}</p>
    </header>

    <div class="container">
      <Cover slug={slug} class="hero-art" light />
    </div>

    <div class="container layout">
      <aside class="side">
        {toc.length > 0 && (
          <nav aria-label={T.toc} class="toc">
            <p>{T.toc}</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        {tags.length > 0 && <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>}
      </aside>

      <div class="prose body">
        <Content />
        <div class="end">
          <p class="ai-note"><Icon name="sparkle" size={16} /> {T.ai} <a href={lp(lang, '/how-it-works/')}>{T.how}</a></p>
          <p>{T.ask}</p>
          <div class="end-ctas">
            <a class="btn btn-primary" href={`mailto:${SITE.email}?subject=${encodeURIComponent(T.re + title)}`}>{T.write} <Icon name="arrow-right" /></a>
            <button type="button" class="btn" data-share data-label={T.copy} data-ok={T.copied} data-fail={T.fail} aria-live="polite"><Icon name="link" size={16} /><span>{T.copy}</span></button>
          </div>
        </div>
      </div>
    </div>

    {nextPost && (
      <div class="container">
        <a class="next" href={postUrl(nextPost)}>
          <Cover slug={slugOf(nextPost)} class="next-art" light />
          <span class="next-body">
            <span class="next-k">{T.next}</span>
            <span class="next-t">{nextPost.data.title}</span>
          </span>
          <Icon name="arrow-right" size={22} class="next-ic" />
        </a>
      </div>
    )}
  </article>
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
    b.addEventListener('click', async () => {
      const span = b.querySelector('span')!;
      try { await navigator.clipboard.writeText(location.href); span.textContent = b.dataset.ok!; }
      catch { span.textContent = b.dataset.fail!; }
      setTimeout(() => (span.textContent = b.dataset.label!), 1800);
    });
  }
</script>

<style>
  /* Reading progress, CSS scroll-driven (no JS, no scroll listeners) */
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress { animation: grow linear both; animation-timeline: scroll(root); }
    }
  }
  @keyframes grow { to { transform: scaleX(1); } }

  .art { padding-bottom: 1px; }
  .ph { padding-top: 64px; padding-bottom: 44px; }
  .back { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-3); text-decoration: none; font-size: 14px; margin-bottom: 36px; }
  .back:hover { color: var(--accent); }
  .meta { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; font: 500 14px/1.4 var(--sans); font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .cat { display: inline-flex; align-items: center; gap: 6px; color: var(--accent); font-weight: 600; text-decoration: none; }
  .cat:hover { text-decoration: underline; text-underline-offset: 3px; }
  .draft { font: 600 11px/1.2 var(--sans); text-transform: uppercase; letter-spacing: .04em; color: var(--accent); border: 1px solid currentColor; border-radius: 6px; padding: 3px 7px; }
  h1 { margin: 18px 0 0; max-width: 20ch; font-size: clamp(2.3rem, 5.4vw, 4.4rem); line-height: 1.02; letter-spacing: -0.035em; font-weight: 650; }
  .dek { margin: 22px 0 0; max-width: 40rem; font-size: clamp(18px, 1.6vw, 21px); color: var(--ink-2); }
  .container :global(.hero-art) { aspect-ratio: 21 / 8; border-radius: 18px; border: 1px solid var(--line); }

  .layout { display: grid; grid-template-columns: 220px minmax(0, 42rem); gap: 72px; padding-top: 64px; justify-content: center; }
  .side { position: sticky; top: 100px; align-self: start; }
  .toc p { margin: 0 0 14px; font: 600 12px/1.2 var(--sans); color: var(--ink-3); text-transform: uppercase; letter-spacing: .05em; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; border-left: 1px solid var(--line); }
  .toc a { display: block; padding-left: 14px; margin-left: -1px; border-left: 1px solid transparent; color: var(--ink-3); text-decoration: none; font-size: 14px; line-height: 1.4; }
  .toc a:hover { color: var(--ink); border-left-color: var(--accent); }
  .tags { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font: 500 13px/1.3 var(--sans); color: var(--ink-2); border: 1px solid var(--line-2); border-radius: var(--r-pill); padding: 4px 10px; }

  .end { margin-top: 64px !important; padding-top: 32px; border-top: 1px solid var(--line); }
  .end p { margin: 0; color: var(--ink); font-size: 18px; }
  .end .ai-note { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 18px; font-size: 14.5px; color: var(--ink-3); }
  .end .ai-note :global(svg) { color: var(--accent); }
  .end .ai-note a { color: var(--ink-2); }
  .end-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }

  .next {
    margin: 96px 0 120px; display: grid; grid-template-columns: 220px 1fr auto; gap: 28px; align-items: center;
    padding: 14px; padding-right: 28px; border: 1px solid var(--line); border-radius: 18px; background: var(--bg-1); text-decoration: none;
    transition: border-color .3s;
  }
  .next:hover { border-color: var(--line-2); }
  .next :global(.next-art) { aspect-ratio: 16 / 10; border-radius: 10px; }
  .next-body { display: grid; gap: 8px; }
  .next-k { font: 500 14px/1.4 var(--sans); font-variant-numeric: tabular-nums; color: var(--ink-3); }
  .next-t { font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.15; }
  .next:hover .next-t { color: var(--accent); }
  .next :global(.next-ic) { color: var(--ink-3); transition: transform .3s var(--ease), color .3s; }
  .next:hover :global(.next-ic) { color: var(--accent); transform: translateX(4px); }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; gap: 0; padding-top: 44px; }
    .side { position: static; display: none; }
    .container :global(.hero-art) { aspect-ratio: 16 / 9; }
  }
  @media (max-width: 640px) {
    .next { grid-template-columns: 1fr; padding: 12px 12px 22px; }
    .next-body { padding: 0 8px; }
    .next :global(.next-ic) { display: none; }
  }
</style>
