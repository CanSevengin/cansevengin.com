---
// "Labirent" mark: an angular C drawn as one continuous line inside a lime square.
// Draws itself once on load and again whenever its [data-mark] parent is hovered.
// `tile` and `stroke` are kept for backwards compatibility.
interface Props { size?: number; class?: string; tile?: boolean; stroke?: number }
const { size = 30, class: cls, stroke = 6 } = Astro.props;
const D = 'M50 14 H14 V50 H50 V38 H26 V26 H50';
---
<svg class:list={['mark', cls]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect class="bg" width="64" height="64" />
  <path class="line" pathLength="1" d={D} fill="none" stroke-width={stroke} stroke-linecap="butt" stroke-linejoin="miter" />
</svg>

<style>
  .mark { overflow: visible; transform-origin: 50% 50%; }
  .bg { fill: #c8f031; }
  .line { stroke: #07080a; stroke-dasharray: 1; stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .mark { animation: mark-pop .5s cubic-bezier(.3, 1.4, .5, 1) both; }
    .mark .line { animation: mark-draw 1.1s cubic-bezier(.65, 0, .35, 1) .1s both; }
    :global(.replay) .mark { animation-name: mark-pop-2; }
    :global(.replay) .mark .line { animation-name: mark-draw-2; }
  }
  /* Two copies of each keyframe so toggling .replay restarts the animation */
  @keyframes mark-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes mark-draw-2 { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes mark-pop { 0% { transform: scale(.82) rotate(-8deg); } 100% { transform: none; } }
  @keyframes mark-pop-2 { 0% { transform: scale(.82) rotate(-8deg); } 100% { transform: none; } }
</style>
