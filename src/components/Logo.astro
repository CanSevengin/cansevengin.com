---
// "İmza" mark: C and S written as one continuous line; the lime dot is the pen tip.
// Writes itself once on load and again whenever its [data-mark] parent is hovered.
interface Props { size?: number; class?: string; tile?: boolean; stroke?: number }
const { size = 30, class: cls, tile = true, stroke = 6 } = Astro.props;
---
<svg class:list={['mark', { tile }, cls]} width={size} height={size} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {tile && <rect class="bg" width="64" height="64" rx="16" />}
  <g transform={tile ? 'translate(5.5 5.5) scale(.83)' : undefined}>
    <path class="line" pathLength="1" d="M30.2 22.8 A13 13 0 1 0 21 45 C 31 45, 52 48.5, 52 39.5 C 52 31, 37.5 33.5, 37.5 25.5 C 37.5 17.5, 49 17, 52.5 21.5" fill="none" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" />
    <circle class="dot" r={stroke * 0.78} />
  </g>
</svg>

<style>
  .mark { overflow: visible; color: var(--ink); }
  .bg { fill: #0f1210; stroke: rgb(200 240 49 / .28); stroke-width: 1; }
  .tile .line { stroke: #f1f3f5; }
  .line { stroke: currentColor; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .dot {
    fill: #c8f031;
    offset-path: path('M30.2 22.8 A13 13 0 1 0 21 45 C 31 45, 52 48.5, 52 39.5 C 52 31, 37.5 33.5, 37.5 25.5 C 37.5 17.5, 49 17, 52.5 21.5');
    offset-distance: 100%;
    offset-rotate: 0deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mark .line { animation: mark-write 1.3s cubic-bezier(.65, 0, .35, 1) .15s both; }
    .mark .dot { animation: mark-ride 1.3s cubic-bezier(.65, 0, .35, 1) .15s both; }
    :global(.replay) .mark .line { animation-name: mark-write-2; }
    :global(.replay) .mark .dot { animation-name: mark-ride-2; }
  }
  @keyframes mark-write { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes mark-write-2 { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes mark-ride { from { offset-distance: 0%; } to { offset-distance: 100%; } }
  @keyframes mark-ride-2 { from { offset-distance: 0%; } to { offset-distance: 100%; } }
</style>
