---
// Email signup through Buttondown (double opt-in). Renders nothing until SITE.buttondown is set.
import { SITE, lp, type Lang } from '../site';
import Icon from './Icon.astro';
interface Props { lang: Lang; variant?: 'notes' | 'ghostline'; class?: string }
const { lang, variant = 'notes', class: cls } = Astro.props;
const T = {
  en: {
    notes: { h: 'Get new notes by email', p: 'One short email when new notes go out. No spam, unsubscribe with one click.', btn: 'Subscribe' },
    ghostline: { h: 'Join the Ghostline early access list', p: 'I’ll write when v1 is ready for a first handful of users.', btn: 'Join the List' },
    ph: 'you@example.com', label: 'Email address', ok: 'Almost done: check your inbox to confirm.', privacy: 'Privacy',
  },
  tr: {
    notes: { h: 'Yeni notlar e-postana gelsin', p: 'Yeni not çıktığında kısa bir e-posta. Spam yok, tek tıkla ayrılırsın.', btn: 'Abone Ol' },
    ghostline: { h: 'Ghostline erken erişim listesine katıl', p: 'v1 ilk birkaç kullanıcı için hazır olduğunda sana yazarım.', btn: 'Listeye Katıl' },
    ph: 'sen@ornek.com', label: 'E-posta adresi', ok: 'Neredeyse tamam: onaylamak için gelen kutuna bak.', privacy: 'Gizlilik',
  },
}[lang];
const v = T[variant];
const tag = variant === 'ghostline' ? 'ghostline' : `notes-${lang}`;
const id = `sub-${variant}`;
---
{SITE.buttondown && (
  <form class:list={['sub', cls]} action={`https://buttondown.com/api/emails/embed-subscribe/${SITE.buttondown}`} method="post" target="_blank" data-sub>
    <div class="sub-copy">
      <p class="sub-h">{v.h}</p>
      <p class="sub-p">{v.p} <a href={lp(lang, '/privacy/')}>{T.privacy}</a></p>
    </div>
    <div class="sub-row">
      <label class="sr" for={id}>{T.label}</label>
      <input id={id} type="email" name="email" required autocomplete="email" placeholder={T.ph} />
      <input type="hidden" name="tag" value={tag} />
      <input type="hidden" name="embed" value="1" />
      <button type="submit" class="btn btn-primary">{v.btn} <Icon name="arrow-right" /></button>
    </div>
    <p class="sub-ok" hidden>{T.ok}</p>
  </form>
)}

<script>
  document.querySelectorAll<HTMLFormElement>('[data-sub]').forEach((f) => {
    f.addEventListener('submit', () => {
      setTimeout(() => { f.querySelector<HTMLElement>('.sub-ok')!.hidden = false; f.reset(); }, 300);
    });
  });
</script>

<style>
  .sub { display: grid; gap: 16px; padding: 24px; border-radius: 22px; background: var(--bg-1); }
  .sub-h { margin: 0; font-size: 1.25rem; font-weight: 650; letter-spacing: -0.02em; color: var(--ink); }
  .sub-p { margin: 6px 0 0; color: var(--ink-2); font-size: 15.5px; }
  .sub-p a { color: var(--ink-3); }
  .sub-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .sub-row input[type='email'] { flex: 1 1 220px; min-width: 0; height: 46px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line-2); background: var(--bg); color: var(--ink); font: 400 16px var(--sans); }
  .sub-row input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sub-ok { margin: 0; color: var(--accent); font-weight: 600; font-size: 15px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
