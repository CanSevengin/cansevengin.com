---
import Cover from './Cover.astro';
import Icon from './Icon.astro';
import { formatDate, readingTime } from '../site';
const { posts } = Astro.props;
---
{posts.length === 0 && (
  <div class="empty">
    <Icon name="pen-nib" size={22} class="ic" />
    <p>The first essays are in review and land here soon. Follow along via <a href="/rss.xml">RSS</a>.</p>
  </div>
)}
<ul class="grid">
  {posts.map((p, i) => (
    <li class:list={[{ wide: i === 0 }]} data-reveal style={`--i:${i % 3}`}>
      <a href={`/blog/${p.id}/`} class="card">
        <Cover slug={p.id} class="art" />
        <div class="body">
          <p class="meta">
            <span>{formatDate(p.data.date)}</span>
            <span>{readingTime(p.body)} min read</span>
            {p.data.draft && <span class="draft">Draft</span>}
          </p>
          <h2>{p.data.title}</h2>
          <p class="d">{p.data.description}</p>
          {p.data.tags.length > 0 && (
            <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
          )}
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .wide { grid-column: 1 / -1; }
  .card {
    display: flex; flex-direction: column; height: 100%; text-decoration: none;
    border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; background: var(--bg-1);
    transition: border-color .3s, transform .4s var(--ease);
  }
  .card:hover { border-color: var(--line-2); transform: translateY(-3px); }
  .card :global(.art) { aspect-ratio: 16 / 9; border-bottom: 1px solid var(--line); }
  .wide .card { display: grid; grid-template-columns: 1.25fr 1fr; }
  .wide .card :global(.art) { aspect-ratio: auto; min-height: 340px; border-bottom: 0; border-right: 1px solid var(--line); }
  .wide .body { align-self: center; padding: 36px; }
  .wide h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); }
  .card:hover :global(svg) { transform: scale(1.04); }
  .body { padding: 22px 24px 26px; }
  .meta { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: center; font: 12.5px var(--mono); color: var(--ink-3); }
  .draft { font: 500 10.5px var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--accent); border: 1px solid rgb(200 240 49 / .5); border-radius: 6px; padding: 2px 6px; }
  h2 { margin: 12px 0 10px; font-size: 1.4rem; line-height: 1.2; letter-spacing: -0.03em; font-weight: 600; transition: color .2s; }
  .card:hover h2 { color: var(--accent); }
  .d { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  .tags { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font: 12px var(--mono); color: var(--ink-2); border: 1px solid var(--line-2); border-radius: var(--r-pill); padding: 4px 10px; }
  .empty { display: flex; gap: 14px; align-items: center; padding: 28px; border: 1px dashed var(--line-2); border-radius: var(--r); color: var(--ink-2); margin-bottom: 20px; }
  .empty p { margin: 0; }
  .empty a { color: var(--accent); }
  .empty :global(.ic) { color: var(--accent); flex: none; }
  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .wide .card { grid-template-columns: 1fr; }
    .wide .card :global(.art) { aspect-ratio: 16 / 9; min-height: 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .wide .body { padding: 22px 24px 26px; }
  }
</style>
